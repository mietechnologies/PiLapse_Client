# PiLapse systemd service — one instance per profile
#
# INSTALL (see README § Install):
#   sudo cp systemd/timelapse@.service /etc/systemd/system/
#   sudo sed -i "s/^User=.*/User=$USER/; s/^Group=.*/Group=$USER/" \
#       /etc/systemd/system/timelapse@.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now timelapse@default
#
# The '@' allows parameterized instances:
#   timelapse@default.service  → profile 'default'
#   timelapse@garden.service   → profile 'garden'
# Only one profile can use a given camera at a time.
#
# MANAGING:
#   sudo systemctl start   timelapse@default
#   sudo systemctl stop    timelapse@default
#   sudo systemctl restart timelapse@default
#   journalctl -u timelapse@default -f    # live logs
#
# SECRETS (recommended approach):
#   Create /etc/timelapse/<profile>.env with 0600 root:root permissions.
#   Add lines like:
#     TIMELAPSE_RTMP_KEY_DEFAULT=your-stream-key
#     TIMELAPSE_WEB_PASSWORD=your-preview-password
#     TIMELAPSE_OWM_KEY=your-owm-api-key
#
#   sudo install -d -m 700 /etc/timelapse
#   sudo install -m 600 /dev/null /etc/timelapse/default.env
#   echo 'TIMELAPSE_RTMP_KEY_DEFAULT=xxxx' | sudo tee -a /etc/timelapse/default.env

[Unit]
Description=PiLapse timelapse service (profile: %i)
After=network-online.target mediamtx.service
Wants=network-online.target
# Retry if the camera isn't ready at first boot, but give up on a crash loop
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Set to the account that ran `timelapse setup` (Raspberry Pi OS Bookworm
# has no default "pi" user) — the sed command above does this.
User=pi
Group=pi
# Camera devices (/dev/video*, /dev/media*) belong to the video group
SupplementaryGroups=video

# Profile name is the systemd instance (%i)
Environment=TIMELAPSE_PROFILE=%i
# Python output straight to the journal, unbuffered
Environment=PYTHONUNBUFFERED=1

# Load secrets from profile-specific env file if it exists
EnvironmentFile=-/etc/timelapse/%i.env

# The venv created in README § Install
ExecStart=/opt/pilapse/venv/bin/timelapse --profile %i run

# Graceful stop on SIGTERM (the app handles it)
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart on failure (not on clean exit or explicit stop)
Restart=on-failure
RestartSec=10

# Stay out of the way of system services.  No CPUQuota: it is measured
# against ONE core, so the old 90% capped this service at under a quarter
# of a quad-core Pi Zero 2 W and slowed video generation.
Nice=5

# Hardening that doesn't affect camera or home-directory access
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

# Logging goes to journald; rotating file logs are also written by the app
StandardOutput=journal
StandardError=journal
SyslogIdentifier=timelapse-%i

[Install]
WantedBy=multi-user.target
